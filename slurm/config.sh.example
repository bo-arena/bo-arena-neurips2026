# Path to your bo-arena repository on the cluster
REPO=/path/to/bo-arena

# Directory for SLURM job output logs
LOGS=/path/to/logs

# SLURM partition names for CPU and GPU jobs
CPU_PARTITION=cpu-partition
GPU_PARTITION=gpu-partition

# Path to the module system init script, needed in batch jobs where the module
# command is not available by default (e.g. /etc/profile.d/lmod.sh).
# Leave empty if module is already available or not needed.
MODULES_INIT=

# Command to make Singularity/Apptainer available (e.g. "module load tools/singularity").
# Leave empty if singularity is already on PATH.
SINGULARITY_SETUP_CMD=

# WandB API key, entity (user or team) and project that experiment runs are logged to
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=
